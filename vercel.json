{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "api/index.py"
    },
    "admin": {
      "root": "admin_dashboard"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend",
        "path": "/health"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "backend",
        "path": "/docs"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend",
        "path": "/openapi.json"
      }
    },
    {
      "source": "/admin/assets/(.*)",
      "destination": {
        "service": "admin",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/admin/(.*\\.[a-zA-Z0-9]+)",
      "destination": {
        "service": "admin",
        "path": "/$1"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin",
        "path": "/index.html"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}


